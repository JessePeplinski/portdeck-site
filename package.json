{
  "name": "portdeck-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "video:studio": "remotion studio video/index.tsx",
    "video:render:mp4": "remotion render video/index.tsx PortDeckMenuDemo public/portdeck-menu-demo.mp4 --codec=h264 --crf=16 --scale=2 --overwrite",
    "video:render:webm": "remotion render video/index.tsx PortDeckMenuDemo public/portdeck-menu-demo.webm --codec=vp9 --crf=18 --scale=2 --overwrite",
    "video:poster": "remotion still video/index.tsx PortDeckMenuDemo public/portdeck-menu-demo-poster.png --frame=92 --scale=2 --overwrite"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "astro": "7.1.2"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.499",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.499",
    "typescript": "6.0.3"
  }
}
