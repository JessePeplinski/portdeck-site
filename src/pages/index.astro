---
import "../styles/global.css";

const downloadUrl =
  "https://github.com/JessePeplinski/portdeck/releases/download/v0.1.0-beta.2/PortDeck-0.1.0-beta.2-macos-arm64.zip";
const sourceUrl = "https://github.com/JessePeplinski/portdeck";

const dashboardProjects = [
  {
    name: "Acme Web",
    status: "running",
    worktrees: [
      {
        name: "main",
        services: [
          { name: "web", port: ":3000", source: "localhost", status: "running", tone: "green" },
          { name: "convex", port: "local dev", source: "convex", status: "running", tone: "green" },
          { name: "postgres", port: ":5432", source: "docker", status: "running", tone: "green" }
        ]
      }
    ]
  },
  {
    name: "PortDeck",
    status: "active",
    worktrees: [
      {
        name: "feature/status-json",
        services: [{ name: "cli", port: "-", source: "portdeck status --json", status: "active", tone: "blue" }]
      }
    ]
  },
  {
    name: "Unknown",
    status: "stale",
    worktrees: [
      {
        name: "unowned",
        services: [{ name: "node", port: ":5173", source: "PID 12345", status: "stale", tone: "amber" }]
      }
    ]
  }
];

const shows = [
  "Localhost servers and listening ports",
  "PID, process name, command, and cwd when available",
  "Git repo root, branch, and worktree",
  "Docker containers with published ports",
  "Project → worktree → service grouping",
  "Open, copy, reveal, kill, and refresh actions"
];

const proFeatures = [
  "Vercel deployment status",
  "Convex status",
  "GitHub Actions status",
  "Cloudflare status",
  "Local vs deployed health",
  "Notifications",
  "Project profiles",
  "Team/shared environments later"
];

const roadmap = [
  {
    version: "V0.1",
    items: [
      "Detect listening localhost ports.",
      "Identify PID, process name, command, and cwd when possible.",
      "Infer Git repo root, branch, and worktree from cwd.",
      "Detect Docker containers with published ports.",
      "Group services by project → worktree → service.",
      "Add actions: open URL, copy URL, reveal folder, kill process, refresh.",
      "Provide portdeck status --json."
    ]
  },
  {
    version: "V0.2",
    items: [
      "Better worktree awareness.",
      "Persistent local service labels.",
      "Project grouping and naming.",
      "Basic config in ~/.portdeck."
    ]
  },
  {
    version: "V0.3",
    items: [
      "portdeck run.",
      "Agent/session awareness for Codex, Claude, and Cursor.",
      "Register services intentionally instead of only discovering them."
    ]
  },
  {
    version: "V0.4",
    items: [
      "Saved service labels.",
      "Custom project grouping.",
      "More runtime health diagnostics."
    ]
  }
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="PortDeck is an AI-native local runtime dashboard for Mac. See local servers, Docker containers, ports, and worktrees from one menu bar."
    />
    <title>PortDeck | AI-native local runtime dashboard</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <section class="hero-screen" aria-labelledby="hero-title" data-menu-open="true">
        <div class="screen-texture" aria-hidden="true"></div>
        <header class="mac-menubar" aria-label="Mac menu bar mock">
          <div class="menu-left">
            <strong>PortDeck</strong>
            <a href="#roadmap">Roadmap</a>
          </div>
          <div class="menu-right">
            <button
              class="portdeck-menu-trigger"
              type="button"
              aria-label="Toggle PortDeck dashboard"
              aria-controls="portdeck-hero-dashboard"
              aria-expanded="true"
            >
              <span aria-hidden="true">›_</span>
            </button>
            <time class="local-time" datetime="" data-local-time>Sat Jun 6 1:11 PM</time>
          </div>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <div class="product-lockup">
              <span class="app-icon" aria-hidden="true"><span>›_</span></span>
              <div>
                <p class="product-name">PortDeck</p>
                <p class="domain">portdeck.app</p>
              </div>
            </div>
            <h1 id="hero-title">Your AI-native local runtime dashboard.</h1>
            <p class="subheadline">See every local server, Docker container, port, and worktree from one Mac menu bar.</p>
            <div class="hero-cta">
              <div class="hero-actions">
                <a
                  class="hero-button primary"
                  href={downloadUrl}
                  aria-label="Download PortDeck v0.1.0-beta.2 for Apple Silicon Macs"
                >
                  <span aria-hidden="true">↓</span>
                  Download
                </a>
                <a
                  class="hero-button secondary"
                  href={sourceUrl}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="View PortDeck source on GitHub in a new tab"
                >
                  View source
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
              <p class="release-note">v0.1.0-beta.2 · macOS 14+ · Apple Silicon</p>
            </div>
          </div>

          <section class="dashboard" id="portdeck-hero-dashboard" aria-label="PortDeck menu bar dashboard mock">
            <div class="popover">
              <div class="search-row">
                <span aria-hidden="true">⌕</span>
                <span>Filter services...</span>
                <kbd>⌘ K</kbd>
              </div>
              <div class="table-head">
                <span>Repo / worktree / service</span>
                <span>Port</span>
                <span>Status</span>
              </div>
              <div class="service-tree">
                {
                  dashboardProjects.map((project) => (
                    <div class="project-block">
                      <div class="project-row">
                        <span class="folder" aria-hidden="true"></span>
                        <strong>{project.name}</strong>
                        <span class={`project-signal ${project.status}`} aria-hidden="true"></span>
                        <span class={`status ${project.status}`}>{project.status}</span>
                      </div>
                      {project.worktrees.map((worktree) => (
                        <div class="worktree-block">
                          <div class="worktree-row">
                            <span aria-hidden="true">↳</span>
                            <span>{worktree.name}</span>
                          </div>
                          {worktree.services.map((service) => (
                            <div class="service-row">
                              <span class={`service-glyph ${service.tone}`} aria-hidden="true"></span>
                              <span class="service-name">{service.name}</span>
                              <span class="service-source">{service.source}</span>
                              <span class="port">{service.port}</span>
                              <span class={`state ${service.tone}`}>{service.status}</span>
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  ))
                }
              </div>
              <div class="action-row" aria-label="Available dashboard actions">
                <span><b aria-hidden="true">↗</b> Open</span>
                <span><b aria-hidden="true">□</b> Copy</span>
                <span><b aria-hidden="true">▱</b> Reveal</span>
                <span><b aria-hidden="true">⌫</b> Kill</span>
                <span><b aria-hidden="true">↻</b> Refresh</span>
              </div>
              <div class="footer-row">
                <span>5 services</span>
                <span>Updated just now · local only</span>
              </div>
            </div>
          </section>
        </div>
      </section>

      <section class="split-section" id="problem">
        <div class="section-icon warning" aria-hidden="true">!</div>
        <h2>The problem</h2>
        <div class="section-body">
          <p>
            Local development used to be one developer, one branch, one server. Now it is one developer, multiple AI
            agents, multiple worktrees, Docker containers, Convex, Vercel previews, and a bunch of local ports.
          </p>
          <p>PortDeck is the control tower for that chaos.</p>
        </div>
      </section>

      <section class="split-section" id="shows">
        <div class="section-icon list" aria-hidden="true">≡</div>
        <h2>What PortDeck shows</h2>
        <ul class="check-list">
          {shows.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="split-section">
        <div class="section-icon bolt" aria-hidden="true">↯</div>
        <h2>Why AI-native builders need this</h2>
        <div class="section-body">
          <p>
            AI agents make it cheap to spin up parallel work. They also make it easy to lose track of which terminal,
            worktree, container, and port belongs to the thing you are testing.
          </p>
          <p>PortDeck keeps the local runtime map visible before stale processes turn into guesswork.</p>
        </div>
      </section>

      <section class="split-section">
        <div class="section-icon open" aria-hidden="true">◎</div>
        <h2>Free/open-source local tool</h2>
        <div class="section-body">
          <p>
            The local dashboard stays free and open source: port discovery, Docker discovery, worktree grouping,
            quick actions, labels, and the CLI.
          </p>
          <p>No auth. No payments. No cloud sync. No telemetry required.</p>
        </div>
      </section>

      <section class="split-section">
        <div class="section-icon star" aria-hidden="true">☆</div>
        <h2>Future Pro features</h2>
        <ul class="check-list pro">
          {proFeatures.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="roadmap-section" id="roadmap">
        <div class="roadmap-intro">
          <div class="section-icon map" aria-hidden="true">◇</div>
          <h2>Public roadmap</h2>
        </div>
        <div class="roadmap-list">
          {
            roadmap.map((release) => (
              <article class="roadmap-item">
                <h3>{release.version}</h3>
                <ul>
                  {release.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
          <article class="roadmap-item future">
            <h3>Future Pro</h3>
            <p>
              Vercel, Convex, GitHub Actions, Cloudflare, local vs deployed health, notifications, project profiles,
              and team/shared environments later.
            </p>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>PortDeck</span>
      <span>Open-source core. Future Pro.</span>
    </footer>
    <script>
      const hero = document.querySelector<HTMLElement>(".hero-screen");
      const trigger = document.querySelector<HTMLButtonElement>(".portdeck-menu-trigger");
      const dashboard = document.querySelector<HTMLElement>("#portdeck-hero-dashboard");
      const localTime = document.querySelector<HTMLTimeElement>("[data-local-time]");

      function formatMenuBarTime(date: Date) {
        const parts = new Intl.DateTimeFormat("en-US", {
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
          hour12: true
        }).formatToParts(date);

        const pick = (type: string) => parts.find((part) => part.type === type)?.value ?? "";
        return `${pick("weekday")} ${pick("month")} ${pick("day")} ${pick("hour")}:${pick("minute")} ${pick("dayPeriod")}`;
      }

      function updateLocalTime() {
        if (!localTime) return;

        const now = new Date();
        localTime.textContent = formatMenuBarTime(now);
        localTime.setAttribute("datetime", now.toISOString());
        updateMenuAlignment();
      }

      function updateMenuAlignment() {
        if (!trigger || !dashboard) return;

        dashboard.style.setProperty("--menu-popover-x", "0px");

        const triggerRect = trigger.getBoundingClientRect();
        const dashboardRect = dashboard.getBoundingClientRect();
        const viewportPadding = 12;
        let shift = triggerRect.right - dashboardRect.right;
        const nextLeft = dashboardRect.left + shift;
        const nextRight = dashboardRect.right + shift;

        if (nextLeft < viewportPadding) {
          shift += viewportPadding - nextLeft;
        } else if (nextRight > window.innerWidth - viewportPadding) {
          shift -= nextRight - (window.innerWidth - viewportPadding);
        }

        dashboard.style.setProperty("--menu-popover-x", `${Math.round(shift)}px`);
      }

      function setMenuOpen(isOpen: boolean) {
        if (!hero || !trigger) return;

        updateMenuAlignment();
        hero.dataset.menuOpen = String(isOpen);
        trigger.setAttribute("aria-expanded", String(isOpen));
        dashboard?.setAttribute("aria-hidden", String(!isOpen));
      }

      updateLocalTime();
      window.setInterval(updateLocalTime, 30000);
      window.addEventListener("resize", updateMenuAlignment);

      trigger?.addEventListener("click", (event) => {
        event.stopPropagation();
        setMenuOpen(hero?.dataset.menuOpen !== "true");
      });

      document.addEventListener("click", (event) => {
        if (!hero || hero.dataset.menuOpen !== "true") return;
        if (!(event.target instanceof Node)) return;
        if (trigger?.contains(event.target) || dashboard?.contains(event.target)) return;
        setMenuOpen(false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenuOpen(false);
      });
    </script>
  </body>
</html>
