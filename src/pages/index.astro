---
import "../styles/global.css";
import SocialIcon from "../components/SocialIcon.astro";

const downloadUrl =
  "https://github.com/JessePeplinski/portdeck/releases/download/v0.1.0-beta.5/PortDeck-0.1.0-beta.5-macos-arm64.dmg";
const sourceUrl = "https://github.com/JessePeplinski/portdeck";
const sourceApiUrl = "https://api.github.com/repos/JessePeplinski/portdeck";
const sourceStarCount = 0;
const installCommand = "brew install --cask JessePeplinski/tap/portdeck@beta";

const shows = [
  "Localhost servers and listening ports",
  "PID, process name, command, and cwd when available",
  "Git repo root, branch, and worktree",
  "Docker containers with published ports",
  "Project → worktree → service grouping",
  "Open, copy, reveal, stop, and refresh actions"
];

const providers = [
  "Vercel",
  "Convex",
  "GitHub Actions",
  "Supabase",
  "Cloudflare",
  "Railway",
  "Fly.io",
  "Netlify"
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="PortDeck is a free, open-source Mac menu-bar command center for local services, saved projects, and read-only deployment health."
    />
    <title>PortDeck | Your command center for the apps you build</title>
    <link rel="icon" href="/portdeck-mark.svg" type="image/svg+xml" />
  </head>
  <body data-source-api-url={sourceApiUrl}>
    <main>
      <section class="hero-screen" aria-labelledby="hero-title" data-demo-open="true">
        <div class="screen-texture" aria-hidden="true"></div>
        <header class="mac-menubar" aria-label="Mac menu bar mock">
          <div class="menu-left">
            <strong>PortDeck</strong>
            <a
              href={downloadUrl}
              download="PortDeck-0.1.0-beta.5-macos-arm64.dmg"
              aria-label="Download PortDeck v0.1.0-beta.5 DMG for Apple Silicon Macs"
            >
              Download
            </a>
            <a
              class="source-link"
              href={sourceUrl}
              target="_blank"
              rel="noreferrer"
              data-source-link
              aria-label={`View PortDeck source on GitHub, ${sourceStarCount} stars, in a new tab`}
            >
              <span>View source</span>
              <span
                class="source-stars"
                data-source-star-badge
                aria-label={`${sourceStarCount} GitHub stars`}
              >
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m8 1.5 1.9 3.85 4.25.62-3.07 3 0.72 4.23L8 11.2 4.2 13.2l.72-4.23-3.07-3 4.25-.62L8 1.5Z"></path>
                </svg>
                <span data-source-star-count aria-hidden="true">{sourceStarCount}</span>
              </span>
            </a>
          </div>
          <div class="menu-right">
            <button
              class="portdeck-menu-trigger"
              type="button"
              aria-label="Hide PortDeck preview"
              aria-controls="portdeck-product-demo"
              aria-expanded="true"
              data-demo-toggle
            >
              <img src="/portdeck-mark.svg" alt="" aria-hidden="true" />
            </button>
            <time class="local-time" datetime="" data-local-time>Sat Jun 6 1:11 PM</time>
          </div>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <div class="product-lockup">
              <img class="app-icon" src="/portdeck-mark.svg" alt="" aria-hidden="true" />
              <div>
                <p class="product-name">PortDeck</p>
                <p class="domain">portdeck.app</p>
              </div>
            </div>
            <h1 id="hero-title">Your command center for the apps you build.</h1>
            <p class="subheadline">
              See what is running locally, control saved projects, and check deployment health from one Mac menu bar.
            </p>
            <div class="hero-cta">
              <div class="install-command" aria-labelledby="homebrew-install-title">
                <div class="install-command-header">
                  <p class="install-command-title" id="homebrew-install-title">Install with Homebrew</p>
                </div>
                <div class="install-command-row">
                  <code translate="no">{installCommand}</code>
                  <button
                    class="copy-command-button"
                    type="button"
                    data-copy-command={installCommand}
                    aria-label="Copy the Homebrew install command"
                  >
                    <svg class="copy-command-icon" viewBox="0 0 20 20" aria-hidden="true">
                      <rect x="7" y="7" width="9" height="9" rx="2"></rect>
                      <path d="M5 13H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span data-copy-label aria-live="polite">Copy</span>
                  </button>
                </div>
              </div>
              <div class="hero-actions">
                <a
                  class="hero-button primary"
                  href={downloadUrl}
                  aria-label="Download PortDeck v0.1.0-beta.5 DMG for Apple Silicon Macs"
                >
                  <span aria-hidden="true">↓</span>
                  Download DMG
                </a>
                <a
                  class="hero-button secondary source-link"
                  href={sourceUrl}
                  target="_blank"
                  rel="noreferrer"
                  data-source-link
                  aria-label={`View PortDeck source on GitHub, ${sourceStarCount} stars, in a new tab`}
                >
                  <span>View source</span>
                  <span
                    class="source-stars"
                    data-source-star-badge
                    aria-label={`${sourceStarCount} GitHub stars`}
                  >
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="m8 1.5 1.9 3.85 4.25.62-3.07 3 0.72 4.23L8 11.2 4.2 13.2l.72-4.23-3.07-3 4.25-.62L8 1.5Z"></path>
                    </svg>
                    <span data-source-star-count aria-hidden="true">{sourceStarCount}</span>
                  </span>
                </a>
              </div>
              <p class="release-note">v0.1.0-beta.5 · macOS 14+ · Apple Silicon</p>
            </div>
          </div>

          <div class="product-demo" id="portdeck-product-demo" data-product-demo-panel>
            <img
              class="product-demo-image"
              src="/portdeck-app-preview.webp"
              width="1075"
              height="1463"
              alt="PortDeck showing local projects, services, ports, branches, and controls"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>

      <section class="split-section" id="problem">
        <h2>Your apps do not live in one terminal.</h2>
        <div class="section-body">
          <p>
            A single app can span local processes, ports, worktrees, Docker containers, and deployments across several
            providers. Answering “what is running?” should not mean retracing every terminal and dashboard.
          </p>
          <p>PortDeck keeps the useful state together and one click away in your Mac menu bar.</p>
        </div>
      </section>

      <section class="split-section" id="shows">
        <h2>See what is running.</h2>
        <ul class="check-list">
          {shows.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="split-section">
        <h2>Keep projects ready.</h2>
        <div class="section-body">
          <p>
            Save a running project once and it stays available even after it stops. Start it again, stop it, open it,
            or switch its confirmed port without rebuilding the command from memory.
          </p>
          <p>PortDeck only controls projects you explicitly save and verifies local ownership before it acts.</p>
        </div>
      </section>

      <section class="split-section">
        <h2>Check deployments without changing them.</h2>
        <div class="section-body">
          <p>
            See production and deployment status across {providers.join(", ")}. PortDeck uses your existing official
            CLI sessions and keeps every provider view read-only.
          </p>
          <p>It cannot deploy, restart, configure, scale, or delete your remote resources.</p>
        </div>
      </section>

      <section class="split-section" id="open-source">
        <h2>Built because I needed it.</h2>
        <div class="section-body">
          <p>
            I built PortDeck to stop losing time figuring out which app owned a port, which project was still running,
            or whether a deployment had finished. I use it every day while I build.
          </p>
          <p>
            No account. No subscription. PortDeck is a free, open-source macOS utility. If it saves you time too, that
            is the whole point.
          </p>
        </div>
      </section>

      <section class="download-section" id="download" aria-labelledby="download-title">
        <div>
          <h2 id="download-title">Try the Apple Silicon beta.</h2>
          <p>
            Install with Homebrew or download the signed and notarized beta for Apple Silicon Macs running macOS 14 or
            newer. Open the DMG and drag PortDeck into Applications. Prefer to inspect it first? The source,
            architecture, and release checks are all public.
          </p>
        </div>
        <div class="download-actions">
          <a class="hero-button primary" href={downloadUrl}>Download DMG</a>
          <a
            class="hero-button secondary source-link"
            href={sourceUrl}
            target="_blank"
            rel="noreferrer"
            data-source-link
            aria-label={`View PortDeck source on GitHub, ${sourceStarCount} stars, in a new tab`}
          >
            <span>View source</span>
            <span
              class="source-stars"
              data-source-star-badge
              aria-label={`${sourceStarCount} GitHub stars`}
            >
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m8 1.5 1.9 3.85 4.25.62-3.07 3 0.72 4.23L8 11.2 4.2 13.2l.72-4.23-3.07-3 4.25-.62L8 1.5Z"></path>
              </svg>
              <span data-source-star-count aria-hidden="true">{sourceStarCount}</span>
            </span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span class="footer-brand">
        <img src="/portdeck-mark.svg" alt="" aria-hidden="true" />
        PortDeck
      </span>
      <span class="footer-credit">
        Built by <a href="https://jessepeplinski.com/" target="_blank" rel="noreferrer">Jesse Peplinski</a>
      </span>
      <nav class="social-links" aria-label="Social links">
        <a href="https://x.com/jessepeplinski" target="_blank" rel="noreferrer" aria-label="X">
          <SocialIcon name="x" />
        </a>
        <a href="https://jessepeplinski.com/" target="_blank" rel="noreferrer" aria-label="Website">
          <SocialIcon name="website" />
        </a>
        <a href="https://www.twitch.tv/peptechdev" target="_blank" rel="noreferrer" aria-label="Twitch">
          <SocialIcon name="twitch" />
        </a>
        <a href="https://instagram.com/peptechdev" target="_blank" rel="noreferrer" aria-label="Instagram">
          <SocialIcon name="instagram" />
        </a>
        <a href="https://tiktok.com/@peptechdev" target="_blank" rel="noreferrer" aria-label="TikTok">
          <SocialIcon name="tiktok" />
        </a>
        <a href="https://github.com/jessePeplinski" target="_blank" rel="noreferrer" aria-label="GitHub">
          <SocialIcon name="github" />
        </a>
        <a
          href="https://www.linkedin.com/in/jessepeplinski"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <SocialIcon name="linkedin" />
        </a>
        <a href="https://www.youtube.com/@PepTechDev" target="_blank" rel="noreferrer" aria-label="YouTube">
          <SocialIcon name="youtube" />
        </a>
      </nav>
    </footer>
    <script>
      const hero = document.querySelector<HTMLElement>(".hero-screen");
      const demoToggle = document.querySelector<HTMLButtonElement>("[data-demo-toggle]");
      const productDemoPanel = document.querySelector<HTMLElement>("[data-product-demo-panel]");
      const localTime = document.querySelector<HTMLTimeElement>("[data-local-time]");
      const copyCommandButton = document.querySelector<HTMLButtonElement>("[data-copy-command]");
      const copyCommandLabel = copyCommandButton?.querySelector<HTMLElement>("[data-copy-label]");
      const sourceLinks = document.querySelectorAll<HTMLAnchorElement>("[data-source-link]");
      const sourceStarBadges = document.querySelectorAll<HTMLElement>("[data-source-star-badge]");
      const sourceStarCounts = document.querySelectorAll<HTMLElement>("[data-source-star-count]");
      let copyResetTimer: number | undefined;

      async function copyInstallCommand(command: string) {
        if (!navigator.clipboard) throw new Error("Clipboard access is unavailable.");
        await navigator.clipboard.writeText(command);
      }

      function formatMenuBarTime(date: Date) {
        const parts = new Intl.DateTimeFormat("en-US", {
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
          hour12: true
        }).formatToParts(date);

        const pick = (type: string) => parts.find((part) => part.type === type)?.value ?? "";
        return `${pick("weekday")} ${pick("month")} ${pick("day")} ${pick("hour")}:${pick("minute")} ${pick("dayPeriod")}`;
      }

      function updateLocalTime() {
        if (!localTime) return;

        const now = new Date();
        localTime.textContent = formatMenuBarTime(now);
        localTime.setAttribute("datetime", now.toISOString());
      }

      async function updateSourceStarCount() {
        const sourceApiUrl = document.body.dataset.sourceApiUrl;
        if (!sourceApiUrl) return;

        try {
          const response = await fetch(sourceApiUrl, {
            headers: { Accept: "application/vnd.github+json" }
          });
          if (!response.ok) return;

          const repository = (await response.json()) as { stargazers_count?: unknown };
          if (
            typeof repository.stargazers_count !== "number" ||
            !Number.isInteger(repository.stargazers_count) ||
            repository.stargazers_count < 0
          ) {
            return;
          }

          const starCount = repository.stargazers_count;
          const formattedStarCount = new Intl.NumberFormat("en-US", {
            notation: starCount >= 1000 ? "compact" : "standard",
            maximumFractionDigits: 1
          }).format(starCount);
          const starLabel = `${starCount.toLocaleString("en-US")} GitHub ${starCount === 1 ? "star" : "stars"}`;

          sourceStarCounts.forEach((count) => {
            count.textContent = formattedStarCount;
          });
          sourceStarBadges.forEach((badge) => {
            badge.setAttribute("aria-label", starLabel);
          });
          sourceLinks.forEach((link) => {
            link.setAttribute("aria-label", `View PortDeck source on GitHub, ${starLabel}, in a new tab`);
          });
        } catch {
          // Keep the server-rendered fallback when GitHub is unavailable.
        }
      }

      updateLocalTime();
      void updateSourceStarCount();
      window.setInterval(updateLocalTime, 30000);

      demoToggle?.addEventListener("click", () => {
        if (!hero) return;

        const isOpen = hero.dataset.demoOpen !== "false";
        const nextOpen = !isOpen;

        hero.dataset.demoOpen = String(nextOpen);
        demoToggle.setAttribute("aria-expanded", String(nextOpen));
        demoToggle.setAttribute("aria-label", nextOpen ? "Hide PortDeck preview" : "Show PortDeck preview");
        productDemoPanel?.setAttribute("aria-hidden", String(!nextOpen));
      });

      copyCommandButton?.addEventListener("click", async () => {
        const command = copyCommandButton.dataset.copyCommand;
        if (!command || !copyCommandLabel) return;

        window.clearTimeout(copyResetTimer);

        try {
          await copyInstallCommand(command);
          copyCommandButton.dataset.copied = "true";
          copyCommandLabel.textContent = "Copied";
          copyCommandButton.setAttribute("aria-label", "Homebrew install command copied");
        } catch {
          copyCommandButton.dataset.copied = "false";
          copyCommandLabel.textContent = "Copy failed";
          copyCommandButton.setAttribute("aria-label", "Copy failed. Select the Homebrew install command manually");
        }

        copyResetTimer = window.setTimeout(() => {
          copyCommandButton.dataset.copied = "false";
          copyCommandLabel.textContent = "Copy";
          copyCommandButton.setAttribute("aria-label", "Copy the Homebrew install command");
        }, 2200);
      });
    </script>
  </body>
</html>
